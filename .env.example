# --- LLM-powered analysis (--use-llm) ---------------------------------------
# The skill scanner supports any LLM provider via LiteLLM (bundled, no extra
# install). Pick ONE option below and fill in your values.
# No provider at all? Skip this file and scan skills with --use-behavioral only.
#
# The MCP scanner (scan_mcp.py) uses the SAME provider you pick below: it reuses
# SKILL_SCANNER_LLM_API_KEY and maps your SKILL_SCANNER_LLM_PROVIDER/MODEL/
# BASE_URL to the format its LiteLLM expects -- Anthropic, OpenAI, Ollama, or any
# OpenAI-compatible endpoint all work with no extra config. (Override only if you
# want a different model for MCP scans: see MCP_SCANNER_LLM_MODEL at the bottom.)
#
# Note: verdict quality depends on model quality. For security decisions,
# prefer a capable model -- small local models weaken threat detection.

# --- Option A: Anthropic (default) ---
SKILL_SCANNER_LLM_PROVIDER=anthropic
SKILL_SCANNER_LLM_API_KEY=sk-ant-...
# claude-haiku is fast and cheap for scanning:
SKILL_SCANNER_LLM_MODEL=claude-haiku-4-5-20251001

# --- Option B: OpenAI ---
# SKILL_SCANNER_LLM_PROVIDER=openai
# SKILL_SCANNER_LLM_API_KEY=sk-...
# SKILL_SCANNER_LLM_MODEL=gpt-4o-mini

# --- Option C: Ollama (local, free, no API key) ---
# The "ollama/" model prefix selects the provider automatically.
# SKILL_SCANNER_LLM_MODEL=ollama/qwen2.5-coder:32b
# SKILL_SCANNER_LLM_BASE_URL=http://localhost:11434   # default, change if remote

# --- Option D: Any OpenAI-compatible endpoint ---
# (OpenRouter, Groq, Azure OpenAI, vLLM, LM Studio, ...)
# SKILL_SCANNER_LLM_PROVIDER=openai-compatible
# SKILL_SCANNER_LLM_API_KEY=...
# SKILL_SCANNER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# SKILL_SCANNER_LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Optional: separate model for the meta analyzer (--enable-meta) ---
# Defaults to the main LLM settings above if unset.
# SKILL_SCANNER_META_LLM_MODEL=
# SKILL_SCANNER_META_LLM_API_KEY=
# SKILL_SCANNER_META_LLM_BASE_URL=

# --- Optional: override the MCP scanner's model (scan_mcp.py) ---
# Not needed normally: scan_mcp.py already derives this from the provider you
# chose above. Set it only to use a DIFFERENT model for MCP scans than for skill
# scans. Value is a LiteLLM model id (provider/model). The Cisco MCP scanner
# defaults to gpt-4o if neither this nor a SKILL_SCANNER_LLM_MODEL is set.
# MCP_SCANNER_LLM_MODEL=anthropic/claude-haiku-4-5-20251001
# MCP_SCANNER_LLM_BASE_URL=     # only for Ollama / OpenAI-compatible overrides

# --- Optional: Cisco AI Defense analyzer ---
# SKILL_SCANNER_AI_DEFENSE_API_KEY=
# SKILL_SCANNER_AI_DEFENSE_ENDPOINT=https://us.api.inspect.aidefense.security.cisco.com/api/v1
