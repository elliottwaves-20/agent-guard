# --- agent-guard LLM configuration -----------------------------------------
# Optional file fallback. Prefer user/process environment variables; see README.
# No .env file is required, and existing process variables take precedence.
#
# agent-guard uses two scanners:
#   1. NVIDIA SkillSpector:
#      - skill scans
#      - static MCP source scans (Stage 1)
#      - full coverage = static patterns/taint/YARA/OSV.dev + SkillSpector LLM
#   2. Cisco mcp-scanner:
#      - optional live MCP runtime scans (remote / --sandbox)
#      - uses LiteLLM and can run with any LiteLLM-supported provider
#
# For full agent-guard coverage, configure BOTH sections:
#   A) SkillSpector LLM -- by default the local coding-agent CLI you already
#      pay for (claude / codex / gemini), no API key needed
#   B) Cisco runtime with any LiteLLM provider (API key required)
#
# If neither a logged-in CLI nor usable hosted credentials are available,
# SkillSpector runs static-only, without the LLM-assisted check.


# ---------------------------------------------------------------------------
# A) NVIDIA SkillSpector LLM (skills + static MCP Stage 1)
# ---------------------------------------------------------------------------
# Recommended: reuse your coding agent's subscription through its CLI. The
# scanner starts the CLI as a separate, tool-less process (claude: `-p
# --permission-mode dontAsk --strict-mcp-config --setting-sources=`; codex:
# `exec --sandbox read-only`), pipes the untrusted skill content via stdin and
# validates the answer against a JSON schema -- so the scanning LLM is isolated
# from the agent that will later install the skill.
#
# If SKILLSPECTOR_PROVIDER is left empty, the wrapper auto-detects: an API key
# below wins if set; otherwise the first CLI found on PATH (claude, codex,
# gemini) is used; otherwise the scan is static-only.

SKILLSPECTOR_PROVIDER=claude_cli          # or codex_cli / gemini_cli
# SKILLSPECTOR_MODEL=                     # empty = the CLI's own default model;
                                          # for codex_cli, gpt-5.6-luna is a
                                          # cost-conscious full-scan choice

# Alternative: hosted API providers (paid per token). Set the provider AND its
# credential; SKILLSPECTOR_MODEL is optional (empty = SkillSpector's default).
# SKILLSPECTOR_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# SKILLSPECTOR_PROVIDER=openai            # also any OpenAI-compatible endpoint
# OPENAI_API_KEY=sk-...                   # (OpenRouter, Groq, vLLM, LM Studio ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# SKILLSPECTOR_PROVIDER=nv_build          # or nv_inference
# NVIDIA_INFERENCE_KEY=nvapi-...
#
# SKILLSPECTOR_PROVIDER=ollama            # local Ollama service, no key

# AWS Bedrock (SKILLSPECTOR_PROVIDER=bedrock, AWS_PROFILE + AWS_REGION) needs one
# extra step in SkillSpector 2.11.2: its analyzers are gated on a resolvable API
# key, and BedrockProvider deliberately returns none because it authenticates
# with SigV4 -- so every semantic analyzer is skipped with "required API key is
# missing". Setting any placeholder OPENAI_API_KEY opens that gate while the
# calls still go to Bedrock (verify: the report's provider tag reads "bedrock").
# Know the trade-off: if AWS credentials stop resolving mid-scan, SkillSpector's
# documented fallback sends the prompt -- which contains the scanned source -- to
# api.openai.com instead. Use durable credentials, not a session that can expire.
# SKILLSPECTOR_MODEL=llama3.1
#
# Also supported by SkillSpector: anthropic_proxy, bedrock, azure_openai,
# openai_compatible -- see `skillspector scan --help` for their variables.

# Disable only the LLM semantic layer, regardless of provider settings above.
# Static analyzers can still use their configured network lookups (for example
# OSV), so this is not an offline-mode guarantee:
# AGENT_GUARD_STATIC_ONLY=1

# SkillSpector's aggregate time budget for one scan. Upstream defaults to 60 s,
# which CLI providers exhaust on medium-sized skills (every LLM call spawns a
# process). agent-guard raises it to AGENT_GUARD_SCAN_TIMEOUT - 60 (= 540 s);
# override here if needed. Same variable name as upstream PR #468.
# SKILLSPECTOR_MAX_WORKFLOW_SECONDS=540

# How many LLM calls SkillSpector may have in flight at once. Upstream's default
# is 10, which suits a normal API quota, and agent-guard leaves it untouched for
# key providers. For a CLI provider the wrapper serializes to 1 unless you set a
# value here: each call is a separate CLI subprocess on one interactive login, so
# a 10-wide burst spends that subscription's rate limit in seconds -- and a 429'd
# batch is dropped from the report, it is not retried. Lower this (not raise it)
# if a scan reports a degraded LLM stage on a rate-limited provider.
# SKILLSPECTOR_MAX_LLM_CONCURRENCY=1

# -- Local models via Ollama ---------------------------------------------------
# Set these on the machine that runs `ollama serve`, not here -- they are read by
# the server at start-up. Ollama caps context at default_num_ctx=4096 even when
# the model supports far more, and SkillSpector prompts reach roughly 7000
# tokens: without this the prompt is truncated silently, producing a weaker scan
# with no error. Verified with an 11041-token prompt (n_ctx_slot = 16384,
# truncated = 0).
#   OLLAMA_CONTEXT_LENGTH=16384
#   OLLAMA_KV_CACHE_TYPE=q8_0
# Note on quality: a local 8B model misses findings a hosted model reports --
# useful as a zero-cost cross-check, not as the only scan.

# -- Distribution: the `skills` CLI --------------------------------------------
# After a SAFE verdict the installer hands distribution to the `skills` CLI
# (vercel-labs/skills, pinned version, run through npx). It writes one canonical
# copy to ~/.agents/skills/<name> and links every agent that it detects -- 80+
# of them, maintained upstream -- with an NTFS junction on Windows and a copy
# fallback. agent-guard runs it only after its own GuardDog scan of that exact
# version matches scripts/reviewed/skills-cli-<version>.json, and only with
# npm_config_ignore_scripts=true and an environment stripped of credentials.
# Set to 0 to use the built-in linker instead (it covers only the agents listed
# in scripts/install_skill.py). The built-in linker also takes over on its own
# whenever npx is missing or verification fails -- an installation never fails
# because of this setting, only the distribution method changes.
# AGENT_GUARD_SKILLS_CLI=0

# Have the CLI copy files instead of linking them. Use for agents that cannot
# follow a link, for example when their skills directory is a container mount.
# AGENT_GUARD_SKILLS_CLI_COPY=1

# Time budget for the delegated CLI run (seconds, default 300). On timeout the
# built-in linker takes over.
# AGENT_GUARD_SKILLS_CLI_TIMEOUT=300

# Require a fully complete inspection before any verdict is given. Off by
# default, matching SkillSpector's own --fail-on-incomplete, which is opt-in
# upstream. With it off, a scan whose only gap is unresolved *references* still
# gets a verdict, with the unresolved references printed as a caveat -- every
# file present was inspected. Files that were genuinely not inspected, a failed
# execution, or a fatal ledger exception still block regardless of this setting.
# Worth knowing: SkillSpector's reference resolver reports ordinary prose such
# as "X/100" or "blog/article" as a path-like reference, so requiring
# completeness denies a verdict to almost every documented skill.
# AGENT_GUARD_FAIL_ON_INCOMPLETE=1


# ---------------------------------------------------------------------------
# B) Cisco mcp-scanner runtime LLM (remote / --sandbox Stage 2)
# ---------------------------------------------------------------------------
# Cisco's scanner uses LiteLLM and has no CLI-subscription path, so this layer
# needs an API key. It is only used for the optional live MCP runtime check.
# You may use OpenAI, Anthropic, Gemini, Bedrock, Azure OpenAI, Ollama, or any
# other LiteLLM-supported provider. This is independent from section A.
#
# Set MCP_SCANNER_LLM_MODEL to a current LiteLLM model identifier for your
# chosen provider. Do not rely on this template for provider model names;
# check your provider/LiteLLM documentation because model availability changes.
# Examples:
#   OpenAI:    MCP_SCANNER_LLM_MODEL=gpt-4.1-mini
#   Anthropic: MCP_SCANNER_LLM_MODEL=claude-haiku-4-5
#   Gemini:    MCP_SCANNER_LLM_MODEL=gemini/gemini-2.5-flash
#   Ollama:    MCP_SCANNER_LLM_MODEL=ollama/llama3.1
# The key and model provider must match: use a Claude/Anthropic model with an
# Anthropic key, a GPT/OpenAI model with an OpenAI key, etc.
# For local LLM endpoints such as Ollama, Cisco still expects
# MCP_SCANNER_LLM_API_KEY to be set; use a harmless dummy value such as
# "ollama" or "test".

# MCP_SCANNER_LLM_API_KEY=your_runtime_llm_key
# MCP_SCANNER_LLM_MODEL=
# MCP_SCANNER_LLM_BASE_URL=                   # custom endpoint / Ollama / Azure
# MCP_SCANNER_LLM_API_VERSION=                # Azure or provider-specific version
# MCP_SCANNER_LLM_TIMEOUT=300                 # optional for extended-thinking models


# ---------------------------------------------------------------------------
# C) Optional VirusTotal binary/archive malware reputation
# ---------------------------------------------------------------------------
# Required for `scan_cli.py binary` (release-binary hash reputation) and useful
# when scanned skills or MCP packages bundle binaries, PDFs, images, archives,
# or other non-source files. Cisco mcp-scanner sends SHA256 hashes by default;
# file contents are uploaded only if you explicitly set
# MCP_SCANNER_VIRUSTOTAL_UPLOAD_FILES=true.
#
# Free/Public API: create a VirusTotal Community account and get your key at
# https://www.virustotal.com/gui/my-apikey. Limits: 500 requests/day and
# 4 requests/minute; non-commercial/non-business-workflow use only. Premium keys
# lift quotas according to the licensed plan and return richer threat context.
# VIRUSTOTAL_API_KEY=your_virustotal_key
# MCP_SCANNER_VT_MAX_FILES=10
# MCP_SCANNER_VIRUSTOTAL_UPLOAD_FILES=false


# ---------------------------------------------------------------------------
# D) Advanced / enterprise: Cisco AI Defense inspect API
# ---------------------------------------------------------------------------
# agent-guard does not require this. Use it only if you already have Cisco AI
# Defense access and want Cisco mcp-scanner's hosted API analyzer in addition to
# the local/LLM/VirusTotal layers above.
# MCP_SCANNER_API_KEY=your_cisco_ai_defense_key
# MCP_SCANNER_ENDPOINT=https://us.api.inspect.aidefense.security.cisco.com/api/v1


# ---------------------------------------------------------------------------
# Removed in agent-guard 0.3.0
# ---------------------------------------------------------------------------
# The legacy SKILL_SCANNER_LLM_* variables (0.1.x) are no longer read. Use the
# SKILLSPECTOR_* names above; they are SkillSpector's own variable names.
