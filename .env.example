# Anthropic API key — required for LLM-powered analysis (--use-llm)
# Get yours at: https://console.anthropic.com/
SKILL_SCANNER_LLM_API_KEY=sk-ant-...

# Model to use for LLM analysis (claude-haiku is fast and cheap for scanning)
SKILL_SCANNER_LLM_MODEL=claude-haiku-4-5-20251001

# Optional: Cisco AI Defense analyzer
# SKILL_SCANNER_AI_DEFENSE_API_KEY=
# SKILL_SCANNER_AI_DEFENSE_ENDPOINT=https://us.api.inspect.aidefense.security.cisco.com/api/v1
